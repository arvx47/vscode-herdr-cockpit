    "keybindings": [
      {
        "key": "ctrl+shift+c",
        "mac": "cmd+c",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
          "text": "\u001b]777;herdr-cockpit;copy\u0007"
        },
        "when": "terminalFocus && herdr.terminalActive && !terminalTextSelected"
      },
      {
        "key": "ctrl+f",
        "mac": "cmd+f",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
