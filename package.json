    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get started with Herdr Cockpit",
        "description": "Bring your Herdr spaces, agents and shells into this window.",
        "steps": [
          {
            "id": "start",
            "title": "Connect to Herdr",
            "description": "The sidebar connects to your running Herdr server.\n[Start Herdr](command:herdr.startServer)",
            "media": {
              "markdown": "media/walkthrough/start.md"
            },
            "completionEvents": [
              "onContext:herdr.connected"
            ]
          },
          {
            "id": "hub",
            "title": "Open the Cockpit window",
            "description": "A dedicated window whose first folder never changes, so switching spaces never restarts extensions.\n[Set Up Cockpit Window](command:herdr.setupHub)",
            "media": {
              "markdown": "media/walkthrough/hub.md"
            },
            "completionEvents": [
              "onCommand:herdr.setupHub"
            ]
          },
          {
            "id": "sidebar",
            "title": "Find the sidebar",
