{
  "name": "herdr-cockpit",
  "displayName": "Herdr Cockpit",
  "description": "Your Herdr agents and spaces in one VS Code window: files, git, diffs and all your extensions next to the agents, with Claude Code, Codex and Kiro usage in one place. No extra Herdr plugins or windows.",
  "version": "0.2.11",
  "publisher": "sriharirao",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#121826",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sriharirao92/vscode-herdr-cockpit.git"
  },
  "homepage": "https://github.com/sriharirao92/vscode-herdr-cockpit#readme",
  "bugs": {
    "url": "https://github.com/sriharirao92/vscode-herdr-cockpit/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "herdr",
    "agents",
    "ai",
    "claude code",
    "codex",
    "kiro",
    "usage",
    "terminal",
    "multiplexer",
    "worktree",
    "git"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "herdr",
          "title": "Herdr Cockpit",
          "icon": "media/herdr.svg"
        }
      ]
    },
    "views": {
      "herdr": [
        {
          "type": "webview",
          "id": "herdr.spaces",
          "name": "Spaces & Agents"
        }
      ]
    },
    "commands": [
      {
        "command": "herdr.refresh",
        "title": "Refresh",
        "category": "Herdr Cockpit",
        "icon": "$(refresh)"
      },
      {
        "command": "herdr.switchSpace",
        "title": "Switch to Space",
        "category": "Herdr Cockpit",
        "icon": "$(arrow-right)"
      },
      {
        "command": "herdr.unmountSpace",
        "title": "Unmount Space",
        "category": "Herdr Cockpit",
        "icon": "$(close)"
      },
      {
        "command": "herdr.openInOwnWindow",
        "title": "Open in Its Own Window",
        "category": "Herdr Cockpit",
        "icon": "$(window)"
      },
      {
        "command": "herdr.addToWorkspace",
        "title": "Add to This Window",
        "category": "Herdr Cockpit",
        "icon": "$(folder-library)"
      },
      {
        "command": "herdr.attachInSpaceWindow",
        "title": "Attach in Its Space's Window",
        "category": "Herdr Cockpit",
        "icon": "$(window)"
      },
      {
        "command": "herdr.attachInThisWindow",
        "title": "Attach in This Window",
        "category": "Herdr Cockpit",
        "icon": "$(terminal)"
      },
      {
        "command": "herdr.askWhereToOpenSpaces",
        "title": "Ask Where to Open Spaces Again (This Window)",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.attach",
        "title": "Attach Terminal",
        "category": "Herdr Cockpit",
        "icon": "$(terminal)"
      },
      {
        "command": "herdr.reviewChanges",
        "title": "Review Agent Changes",
        "category": "Herdr Cockpit",
        "icon": "$(diff)"
      },
      {
        "command": "herdr.focusAttention",
        "title": "Jump to Agent Needing Attention",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.goToPane",
        "title": "Go to Agent or Shell…",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.promptAgent",
        "title": "Prompt Agent…",
        "category": "Herdr Cockpit",
        "icon": "$(comment)"
      },
      {
        "command": "herdr.sendToAgent",
        "title": "Send to Agent…",
        "category": "Herdr Cockpit",
        "icon": "$(send)"
      },
      {
        "command": "herdr.openTui",
        "title": "Open Herdr TUI",
        "category": "Herdr Cockpit",
        "icon": "$(window)"
      },
      {
        "command": "herdr.setupHub",
        "title": "Set Up Cockpit Window",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.toggleFollow",
        "title": "Follow Herdr Focus",
        "category": "Herdr Cockpit",
        "toggled": "config.herdr.followMode"
      },
      {
        "command": "herdr.dumpSnapshot",
        "title": "Show Raw Session Snapshot",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.toggleShellPanes",
        "title": "Toggle Shell Panes",
        "category": "Herdr Cockpit",
        "icon": "$(terminal)"
      },
      {
        "command": "herdr.openSettings",
        "title": "Settings",
        "category": "Herdr Cockpit",
        "icon": "$(settings-gear)"
      },
      {
        "command": "herdr.showRaw",
        "title": "Show Raw Herdr Record",
        "category": "Herdr Cockpit",
        "icon": "$(json)"
      },
      {
        "command": "herdr.openHelp",
        "title": "How to Read the Sidebar",
        "category": "Herdr Cockpit",
        "icon": "$(question)"
      },
      {
        "command": "herdr.newTab",
        "title": "New Tab…",
        "category": "Herdr Cockpit",
        "icon": "$(add)"
      },
      {
        "command": "herdr.reopenClosedTab",
        "title": "Reopen Closed Tab (Herdr Tabs and Editors)",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.rename",
        "title": "Rename…",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.closeInHerdr",
        "title": "Close in Herdr…",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.newSpace",
        "title": "New Space…",
        "category": "Herdr Cockpit",
        "icon": "$(add)"
      },
      {
        "command": "herdr.setupClaudeUsage",
        "title": "Show Claude Plan Limits in the Sidebar…",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.setKiroCredits",
        "title": "Set Kiro Monthly Credits…",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.startServer",
        "title": "Start Herdr",
        "category": "Herdr Cockpit",
        "icon": "$(play)"
      },
      {
        "command": "herdr.copyDiagnostics",
        "title": "Copy Diagnostics",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.connectionMenu",
        "title": "Connection Options",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.openInstallDocs",
        "title": "Install Herdr",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.installPlugin",
        "title": "Install the Herdr Plugin",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.terminal.find",
        "title": "Find in Terminal (Whole History)",
        "category": "Herdr Cockpit",
        "icon": "$(search)"
      },
      {
        "command": "herdr.terminal.findNext",
        "title": "Find Next in Terminal (Older)",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.terminal.findPrevious",
        "title": "Find Previous in Terminal (Newer)",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.terminal.pageUp",
        "title": "Terminal: Scroll Page Up",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.terminal.pageDown",
        "title": "Terminal: Scroll Page Down",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.terminal.scrollToTop",
        "title": "Terminal: Scroll to Top of History",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.terminal.scrollToBottom",
        "title": "Terminal: Scroll to Bottom",
        "category": "Herdr Cockpit"
      },
      {
        "command": "herdr.terminal.openOutput",
        "title": "Open Terminal Output in Editor",
        "category": "Herdr Cockpit",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "herdr.openHelp",
          "when": "view == herdr.spaces",
          "group": "navigation@1"
        },
        {
          "command": "herdr.startServer",
          "when": "view == herdr.spaces && !herdr.connected",
          "group": "0_start@1"
        },
        {
          "command": "herdr.toggleFollow",
          "when": "view == herdr.spaces",
          "group": "1_follow@1"
        },
        {
          "command": "herdr.openTui",
          "when": "view == herdr.spaces",
          "group": "2_open@1"
        },
        {
          "command": "herdr.setupHub",
          "when": "view == herdr.spaces",
          "group": "2_open@2"
        },
        {
          "command": "herdr.refresh",
          "when": "view == herdr.spaces",
          "group": "3_tools@1"
        },
        {
          "command": "herdr.openSettings",
          "when": "view == herdr.spaces",
          "group": "3_tools@2"
        }
      ],
      "commandPalette": [
        {
          "command": "herdr.unmountSpace",
          "when": "false"
        },
        {
          "command": "herdr.openInOwnWindow",
          "when": "false"
        },
        {
          "command": "herdr.addToWorkspace",
          "when": "false"
        },
        {
          "command": "herdr.attachInSpaceWindow",
          "when": "false"
        },
        {
          "command": "herdr.attachInThisWindow",
          "when": "false"
        },
        {
          "command": "herdr.attach",
          "when": "false"
        },
        {
          "command": "herdr.rename",
          "when": "false"
        },
        {
          "command": "herdr.closeInHerdr",
          "when": "false"
        },
        {
          "command": "herdr.connectionMenu",
          "when": "false"
        },
        {
          "command": "herdr.openInstallDocs",
          "when": "false"
        },
        {
          "command": "herdr.terminal.find",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.terminal.findNext",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.terminal.findPrevious",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.terminal.pageUp",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.terminal.pageDown",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.terminal.scrollToTop",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.terminal.scrollToBottom",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.terminal.openOutput",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.promptAgent",
          "when": "herdr.connected"
        },
        {
          "command": "herdr.sendToAgent",
          "when": "herdr.connected && editorIsOpen"
        },
        {
          "command": "herdr.goToPane",
          "when": "herdr.connected"
        }
      ],
      "webview/context": [
        {
          "command": "herdr.switchSpace",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^space/",
          "group": "1_space@1"
        },
        {
          "command": "herdr.unmountSpace",
          "when": "webviewId == herdr.spaces && webviewSection == space-mounted",
          "group": "1_space@2"
        },
        {
          "command": "herdr.openInOwnWindow",
          "when": "webviewId == herdr.spaces && webviewSection == space",
          "group": "1_window@1"
        },
        {
          "command": "herdr.addToWorkspace",
          "when": "webviewId == herdr.spaces && webviewSection == space",
          "group": "1_window@2"
        },
        {
          "command": "herdr.attachInSpaceWindow",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^(agent|shell)$/ && !spaceHere",
          "group": "1_window@1"
        },
        {
          "command": "herdr.attachInThisWindow",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^(agent|shell)$/ && !spaceHere",
          "group": "1_window@2"
        },
        {
          "command": "herdr.attach",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^(agent|shell)$/ && spaceHere",
          "group": "1_pane@1"
        },
        {
          "command": "herdr.promptAgent",
          "when": "webviewId == herdr.spaces && webviewSection == agent",
          "group": "1_pane@2"
        },
        {
          "command": "herdr.reviewChanges",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^(space|space-mounted|agent)$/",
          "group": "2_review@1"
        },
        {
          "command": "herdr.newTab",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^space/",
          "group": "0_create@1"
        },
        {
          "command": "herdr.rename",
          "when": "webviewId == herdr.spaces && webviewSection",
          "group": "7_edit@1"
        },
        {
          "command": "herdr.closeInHerdr",
          "when": "webviewId == herdr.spaces && webviewSection",
          "group": "8_close@1"
        }
      ],
      "terminal/context": [
        {
          "command": "herdr.terminal.find",
          "when": "herdr.terminalActive",
          "group": "0_herdr@1"
        },
        {
          "command": "herdr.terminal.openOutput",
          "when": "herdr.terminalActive",
          "group": "0_herdr@2"
        }
      ],
      "terminal/title/context": [
        {
          "command": "herdr.terminal.find",
          "when": "herdr.terminalActive",
          "group": "0_herdr@1"
        },
        {
          "command": "herdr.terminal.openOutput",
          "when": "herdr.terminalActive",
          "group": "0_herdr@2"
        }
      ],
      "editor/context": [
        {
          "command": "herdr.sendToAgent",
          "when": "herdr.connected && resourceScheme == file",
          "group": "herdr@1"
        }
      ],
      "explorer/context": [
        {
          "command": "herdr.sendToAgent",
          "when": "herdr.connected && !explorerResourceIsFolder",
          "group": "herdr@1"
        }
      ]
    },
    "configuration": {
      "title": "Herdr Cockpit",
      "properties": {
        "herdr.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the herdr binary. Empty = auto-detect (Homebrew, ~/.local/bin, PATH). Machine setting: ignored in workspace and folder settings, so a repository can't choose the program the extension runs.",
          "scope": "machine"
        },
        "herdr.socketPath": {
          "type": "string",
          "default": "",
          "description": "Herdr socket path. Empty = HERDR_SOCKET_PATH, then ~/.config/herdr/herdr.sock. Machine setting: ignored in workspace and folder settings.",
          "scope": "machine"
        },
        "herdr.startServer": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "enumDescriptions": [
            "Ask once when the Cockpit window opens and Herdr isn't running, then remember the answer.",
            "Start Herdr in the background whenever the Cockpit window opens and it isn't running.",
            "Never start Herdr automatically (the sidebar still offers a Start Herdr button)."
          ],
          "description": "Whether the Herdr Cockpit window starts the Herdr server (in the background) when it isn't running."
        },
        "herdr.offerHubOnStartup": {
          "type": "string",
          "enum": [
            "emptyWindows",
            "allWindows",
            "never"
          ],
          "default": "emptyWindows",
          "enumDescriptions": [
            "Ask in windows opened without a folder (a new window, or the editor's first launch).",
            "Ask in every window that isn't the hub (the hub then opens in a new window).",
            "Never ask."
          ],
          "description": "When a window opens, offer to open Herdr Cockpit (only when Herdr is installed and no Cockpit window is open)."
        },
        "herdr.followMode": {
          "type": "boolean",
          "default": true,
          "description": "When you switch spaces in Herdr (e.g. in your Mac terminal), this window follows. Only active in a Cockpit window or after you've switched a space from VS Code."
        },
        "herdr.terminalLocation": {
          "type": "string",
          "enum": [
            "editor",
            "editorSplit",
            "panel"
          ],
          "default": "editor",
          "enumDescriptions": [
            "Editor area, as tabs in the active group.",
            "Editor area, agents in the left group and shells in the right one.",
            "The terminal panel."
          ],
          "description": "Where attached agent and shell terminals open."
        },
        "herdr.revealInExplorer": {
          "type": "boolean",
          "default": false,
          "description": "When switching to a space (also by opening one of its panes), reveal its folder in the Explorer, which opens and focuses the Explorer view. Off by default, so the side bar stays where it is."
        },
        "herdr.windowMode": {
          "type": "string",
          "enum": [
            "folder",
            "workspace"
          ],
          "enumDescriptions": [
            "Each space gets a window of its own, opened on its folder. Clicking a space or pane this window doesn't have brings forward the window that has it, or asks whether to open it in its own window or add it to this window.",
            "Spaces are mounted as folders of one workspace, normally the Cockpit window (the behavior before this setting). A space another window already has still opens there."
          ],
          "default": "folder",
          "markdownDescription": "How spaces map to windows. In either mode, right-click a space for **Open in Its Own Window** or **Add to This Window**, or a pane whose space isn't in this window for **Attach in Its Space's Window** or **Attach in This Window**."
        },
        "herdr.closeTerminalsOnSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Close attach terminals of other spaces when switching. Agents keep running in Herdr."
        },
        "herdr.restoreTabs": {
          "type": "boolean",
          "default": true,
          "description": "When a window opens again, reopen the Herdr tabs it had when it was closed (panes that still exist in Herdr). A pane another window has stays there and shows read-only here."
        },
        "herdr.closeTabInHerdr": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "enumDescriptions": [
            "Close idle shells in Herdr right away; ask first for an agent, a shell running something, or a space's last tab.",
            "Close in Herdr without asking (still asks for a space's last tab, which closes the space).",
            "Closing a tab only detaches: the agent or shell keeps running in Herdr."
          ],
          "description": "What closing a Herdr terminal tab yourself (its X) does in Herdr. Switching spaces and closing the window never close anything in Herdr."
        },
        "herdr.autoAttach": {
          "type": "string",
          "enum": [
            "all",
            "agents",
            "none"
          ],
          "enumDescriptions": [
            "Every pane: agents first (most urgent first), then shells in tab order.",
            "Only the agents; shells stay in the sidebar until you click one.",
            "Nothing: click a pane in the sidebar to open it."
          ],
          "default": "all",
          "description": "Which of a space's panes open as terminal tabs when you switch to it. Replaces herdr.autoAttachOnSwitch and herdr.autoAttachShells, which are still read until this is set."
        },
        "herdr.agentNames": {
          "type": "string",
          "enum": [
            "title",
            "herdr"
          ],
          "enumDescriptions": [
            "An agent you haven't named shows its terminal title, e.g. Claude Code's session name. Default titles (\"Claude Code\") and folder paths are skipped.",
            "Only Herdr's names: \"Claude\", \"Claude 2\", or a name you chose."
          ],
          "default": "title",
          "description": "How agent tabs and sidebar rows are named."
        },
        "herdr.notifyOn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "blocked",
              "done",
              "working",
              "idle"
            ]
          },
          "default": [
            "blocked",
            "done"
          ],
          "description": "Agent states that trigger a VS Code notification."
        },
        "herdr.notifyOnTakeover": {
          "type": "boolean",
          "default": true,
          "description": "Notify when another client (a Cockpit window in another editor, or `herdr attach`) takes over a pane this window shows. The tab keeps showing the pane read-only; type in it to take it back."
        },
        "herdr.agents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "claude",
            "codex",
            "kiro",
            "cursor"
          ],
          "description": "Agents offered first when creating a tab or space (Herdr agent kinds, e.g. claude, codex, kiro, cursor, gemini, copilot, opencode, amp). The rest are under \"More agents…\"."
        },
        "herdr.kiroMonthlyCredits": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Your Kiro plan's monthly credit allowance (Kiro shows it in /usage). Kiro doesn't expose it to other tools, so enter it here to see a usage bar in the sidebar. 0 = unknown."
        },
        "herdr.showShellPanes": {
          "type": "boolean",
          "default": true,
          "description": "Show plain shell panes under each space (Herdr's own agent list hides them)."
        },
        "herdr.spaceOrder": {
          "type": "string",
          "enum": [
            "activity",
            "herdr"
          ],
          "enumDescriptions": [
            "Spaces with an agent working or waiting on you first, then the most recently active (an agent changed state, or you switched to it).",
            "The order the spaces have in Herdr."
          ],
          "default": "herdr",
          "description": "How the sidebar orders spaces. Herdr's own order by default."
        }
      }
    },
    "terminal": {
      "profiles": [
        {
          "id": "herdr.shell",
          "title": "Herdr Shell",
          "icon": "terminal"
        },
        {
          "id": "herdr.agent.claude",
          "title": "Herdr: Claude",
          "icon": {
