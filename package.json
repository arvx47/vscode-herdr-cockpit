    "codicons": "node scripts/copy-codicons.mjs",
    "pretest": "tsc -p .",
    "test": "node out/test/mockTest.js && node out/test/viewTest.js && node out/test/usageTest.js && node out/test/connectionTest.js && node out/test/syncTest.js && node out/test/placementTest.js && node out/test/hubTest.js && node out/test/pluginTest.js && node out/test/streamTest.js && node out/test/findTest.js && node out/test/gitTest.js",
    "package": "npm run codicons && tsc -p . && vsce package",
    "install-local": "npm run package && node scripts/install-local.mjs",
    "lint": "eslint --no-warn-ignored src media/*.js scripts",
    "test:vscode": "npm run compile && node out/test/vscode/run.js"
  },
