  "scripts": {
    "compile": "tsc -p . && npm run build:webview",
    "build:webview": "tsc -p tsconfig.webview.json && node scripts/build-webview.mjs",
    "watch": "tsc -watch -p .",
    "gen:types": "node scripts/gen-herdr-types.mjs",
    "gen:icons": "node scripts/gen-agent-icons.mjs",
    "codicons": "node scripts/copy-codicons.mjs",
    "pretest": "tsc -p .",
    "test": "node out/test/mockTest.js && node out/test/viewTest.js && node out/test/usageTest.js && node out/test/usageScriptTest.js && node out/test/connectionTest.js && node out/test/syncTest.js && node out/test/tabMatchTest.js && node out/test/noticesTest.js && node out/test/agentProfilesTest.js && node out/test/placementTest.js && node out/test/hubTest.js && node out/test/pluginTest.js && node out/test/streamTest.js && node out/test/findTest.js && node out/test/termFindTest.js && node out/test/gitTest.js",
    "package": "npm run codicons && npm run compile && vsce package",
    "install-local": "npm run package && node scripts/install-local.mjs",
    "lint": "eslint --no-warn-ignored src webview media/*.js scripts",
    "test:vscode": "npm run compile && node out/test/vscode/run.js"
  },
