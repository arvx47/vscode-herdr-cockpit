{
  "name": "herdr-cockpit",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.38",
  "publisher": "sriharirao",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#121826",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sriharirao92/vscode-herdr-cockpit.git"
  },
  "homepage": "https://github.com/sriharirao92/vscode-herdr-cockpit#readme",
  "bugs": {
    "url": "https://github.com/sriharirao92/vscode-herdr-cockpit/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "herdr",
    "agents",
    "ai",
    "claude code",
    "codex",
    "kiro",
    "usage",
    "terminal",
    "multiplexer",
    "worktree",
    "git"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "herdr",
          "title": "%viewContainer.herdr%",
          "icon": "media/herdr.svg"
        }
      ]
    },
    "views": {
      "herdr": [
        {
          "type": "webview",
          "id": "herdr.spaces",
          "name": "%view.herdr.spaces%"
        }
      ]
    },
    "commands": [
      {
        "command": "herdr.refresh",
        "title": "%command.refresh%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "herdr.switchSpace",
        "title": "%command.switchSpace%",
        "category": "%category%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "herdr.unmountSpace",
        "title": "%command.unmountSpace%",
        "category": "%category%",
        "icon": "$(close)"
      },
      {
        "command": "herdr.openInOwnWindow",
        "title": "%command.openInOwnWindow%",
        "category": "%category%",
        "icon": "$(window)"
      },
      {
        "command": "herdr.addToWorkspace",
        "title": "%command.addToWorkspace%",
        "category": "%category%",
        "icon": "$(folder-library)"
      },
      {
        "command": "herdr.attachInSpaceWindow",
        "title": "%command.attachInSpaceWindow%",
        "category": "%category%",
        "icon": "$(window)"
      },
      {
        "command": "herdr.attachInThisWindow",
        "title": "%command.attachInThisWindow%",
        "category": "%category%",
        "icon": "$(terminal)"
      },
      {
        "command": "herdr.askWhereToOpenSpaces",
        "title": "%command.askWhereToOpenSpaces%",
        "category": "%category%"
      },
      {
        "command": "herdr.attach",
        "title": "%command.attach%",
        "category": "%category%",
        "icon": "$(terminal)"
      },
      {
        "command": "herdr.reviewChanges",
        "title": "%command.reviewChanges%",
        "category": "%category%",
        "icon": "$(diff)"
      },
      {
        "command": "herdr.focusAttention",
        "title": "%command.focusAttention%",
        "category": "%category%"
      },
      {
        "command": "herdr.goToPane",
        "title": "%command.goToPane%",
        "category": "%category%"
      },
      {
        "command": "herdr.promptAgent",
        "title": "%command.promptAgent%",
        "category": "%category%",
        "icon": "$(comment)"
      },
      {
        "command": "herdr.sendToAgent",
        "title": "%command.sendToAgent%",
        "category": "%category%",
        "icon": "$(send)"
      },
      {
        "command": "herdr.openTui",
        "title": "%command.openTui%",
        "category": "%category%",
        "icon": "$(window)"
      },
      {
        "command": "herdr.setupHub",
        "title": "%command.setupHub%",
        "category": "%category%"
      },
      {
        "command": "herdr.toggleFollow",
        "title": "%command.toggleFollow%",
        "category": "%category%",
        "toggled": "config.herdr.followMode"
      },
      {
        "command": "herdr.dumpSnapshot",
        "title": "%command.dumpSnapshot%",
        "category": "%category%"
      },
      {
        "command": "herdr.toggleShellPanes",
        "title": "%command.toggleShellPanes%",
        "category": "%category%",
        "icon": "$(terminal)",
        "toggled": "config.herdr.showShellPanes"
      },
      {
        "command": "herdr.openSettings",
        "title": "%command.openSettings%",
        "category": "%category%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "herdr.showRaw",
        "title": "%command.showRaw%",
        "category": "%category%",
        "icon": "$(json)"
      },
      {
        "command": "herdr.openHelp",
        "title": "%command.openHelp%",
        "category": "%category%",
        "icon": "$(question)"
      },
      {
        "command": "herdr.newTab",
        "title": "%command.newTab%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "herdr.reopenClosedTab",
        "title": "%command.reopenClosedTab%",
        "category": "%category%"
      },
      {
        "command": "herdr.rename",
        "title": "%command.rename%",
        "category": "%category%"
      },
      {
        "command": "herdr.closeInHerdr",
        "title": "%command.closeInHerdr%",
        "category": "%category%"
      },
      {
        "command": "herdr.newSpace",
        "title": "%command.newSpace%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "herdr.newSpaceHere",
        "title": "%command.newSpaceHere%",
        "category": "%category%"
      },
      {
        "command": "herdr.newWorktree",
        "title": "%command.newWorktree%",
        "category": "%category%",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "herdr.setupClaudeUsage",
        "title": "%command.setupClaudeUsage%",
        "category": "%category%"
      },
      {
        "command": "herdr.setKiroCredits",
        "title": "%command.setKiroCredits%",
        "category": "%category%"
      },
      {
        "command": "herdr.startServer",
        "title": "%command.startServer%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "herdr.copyDiagnostics",
        "title": "%command.copyDiagnostics%",
        "category": "%category%"
      },
      {
        "command": "herdr.connectionMenu",
        "title": "%command.connectionMenu%",
        "category": "%category%"
      },
      {
        "command": "herdr.openInstallDocs",
        "title": "%command.openInstallDocs%",
        "category": "%category%"
      },
      {
        "command": "herdr.installPlugin",
        "title": "%command.installPlugin%",
        "category": "%category%"
      },
      {
        "command": "herdr.terminal.splitPane",
        "title": "%command.terminal.splitPane%",
        "category": "%category%",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "herdr.terminal.find",
        "title": "%command.terminal.find%",
        "category": "%category%",
        "icon": "$(search)"
      },
      {
        "command": "herdr.terminal.findNext",
        "title": "%command.terminal.findNext%",
        "category": "%category%"
      },
      {
        "command": "herdr.terminal.findPrevious",
        "title": "%command.terminal.findPrevious%",
        "category": "%category%"
      },
      {
        "command": "herdr.terminal.pageUp",
        "title": "%command.terminal.pageUp%",
        "category": "%category%"
      },
      {
        "command": "herdr.terminal.pageDown",
        "title": "%command.terminal.pageDown%",
        "category": "%category%"
      },
      {
        "command": "herdr.terminal.scrollToTop",
        "title": "%command.terminal.scrollToTop%",
        "category": "%category%"
      },
      {
        "command": "herdr.terminal.scrollToBottom",
        "title": "%command.terminal.scrollToBottom%",
        "category": "%category%"
      },
      {
        "command": "herdr.terminal.openOutput",
        "title": "%command.terminal.openOutput%",
        "category": "%category%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "herdr.openAgents",
        "title": "%command.openAgents%",
        "category": "%category%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "herdr.openHelp",
          "when": "view == herdr.spaces",
          "group": "navigation@1"
        },
        {
          "command": "herdr.startServer",
          "when": "view == herdr.spaces && !herdr.connected",
          "group": "0_start@1"
        },
        {
          "command": "herdr.toggleFollow",
          "when": "view == herdr.spaces",
          "group": "1_follow@1"
        },
        {
          "command": "herdr.toggleShellPanes",
          "when": "view == herdr.spaces",
          "group": "1_follow@2"
        },
        {
          "command": "herdr.openTui",
          "when": "view == herdr.spaces",
          "group": "2_open@1"
        },
        {
          "command": "herdr.setupHub",
          "when": "view == herdr.spaces",
          "group": "2_open@2"
        },
        {
          "command": "herdr.refresh",
          "when": "view == herdr.spaces",
          "group": "3_tools@1"
        },
        {
          "command": "herdr.openSettings",
          "when": "view == herdr.spaces",
          "group": "3_tools@2"
        },
        {
          "command": "herdr.openAgents",
          "when": "view == herdr.spaces",
          "group": "4_usage@0"
        },
        {
          "command": "herdr.setupClaudeUsage",
          "when": "view == herdr.spaces && herdr.claudeLimitsOn",
          "group": "4_usage@1"
        }
      ],
      "commandPalette": [
        {
          "command": "herdr.unmountSpace",
          "when": "false"
        },
        {
          "command": "herdr.openInOwnWindow",
          "when": "false"
        },
        {
          "command": "herdr.addToWorkspace",
          "when": "false"
        },
        {
          "command": "herdr.attachInSpaceWindow",
          "when": "false"
        },
        {
          "command": "herdr.attachInThisWindow",
          "when": "false"
        },
        {
          "command": "herdr.attach",
          "when": "false"
        },
        {
          "command": "herdr.rename",
          "when": "false"
        },
        {
          "command": "herdr.closeInHerdr",
          "when": "false"
        },
        {
          "command": "herdr.connectionMenu",
          "when": "false"
        },
        {
          "command": "herdr.openInstallDocs",
          "when": "false"
        },
        {
          "command": "herdr.terminal.find",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.terminal.findNext",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.terminal.findPrevious",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.terminal.pageUp",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.terminal.pageDown",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.terminal.scrollToTop",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.terminal.scrollToBottom",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.terminal.openOutput",
          "when": "herdr.terminalActive"
        },
        {
          "command": "herdr.promptAgent",
          "when": "herdr.connected"
        },
        {
          "command": "herdr.sendToAgent",
          "when": "herdr.connected && editorIsOpen"
        },
        {
          "command": "herdr.goToPane",
          "when": "herdr.connected"
        },
        {
          "command": "herdr.terminal.splitPane",
          "when": "herdr.connected && herdr.terminalActive"
        },
        {
          "command": "herdr.switchSpace",
          "when": "herdr.connected"
        },
        {
          "command": "herdr.newTab",
          "when": "herdr.connected"
        },
        {
          "command": "herdr.newSpace",
          "when": "herdr.connected"
        },
        {
          "command": "herdr.newSpaceHere",
          "when": "herdr.connected"
        },
        {
          "command": "herdr.newWorktree",
          "when": "herdr.connected"
        },
        {
          "command": "herdr.focusAttention",
          "when": "herdr.connected"
        },
        {
          "command": "herdr.dumpSnapshot",
          "when": "herdr.connected"
        },
        {
          "command": "herdr.showRaw",
          "when": "herdr.connected"
        },
        {
          "command": "herdr.startServer",
          "when": "!herdr.connected"
        }
      ],
      "webview/context": [
        {
          "command": "herdr.switchSpace",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^space/",
          "group": "1_space@1"
        },
        {
          "command": "herdr.unmountSpace",
          "when": "webviewId == herdr.spaces && webviewSection == space-mounted",
          "group": "1_space@2"
        },
        {
          "command": "herdr.openInOwnWindow",
          "when": "webviewId == herdr.spaces && webviewSection == space",
          "group": "1_window@1"
        },
        {
          "command": "herdr.addToWorkspace",
          "when": "webviewId == herdr.spaces && webviewSection == space",
          "group": "1_window@2"
        },
        {
          "command": "herdr.attachInSpaceWindow",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^(agent|shell)$/ && !spaceHere",
          "group": "1_window@1"
        },
        {
          "command": "herdr.attachInThisWindow",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^(agent|shell)$/ && !spaceHere",
          "group": "1_window@2"
        },
        {
          "command": "herdr.attach",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^(agent|shell)$/ && spaceHere",
          "group": "1_pane@1"
        },
        {
          "command": "herdr.promptAgent",
          "when": "webviewId == herdr.spaces && webviewSection == agent",
          "group": "1_pane@2"
        },
        {
          "command": "herdr.reviewChanges",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^(space|space-mounted|agent)$/",
          "group": "2_review@1"
        },
        {
          "command": "herdr.newTab",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^space/",
          "group": "0_create@1"
        },
        {
          "command": "herdr.newWorktree",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^space/ && spaceRepo",
          "group": "0_create@2"
        },
        {
          "command": "herdr.rename",
          "when": "webviewId == herdr.spaces && webviewSection",
          "group": "7_edit@1"
        },
        {
          "command": "herdr.closeInHerdr",
          "when": "webviewId == herdr.spaces && webviewSection",
          "group": "8_close@1"
        }
      ],
      "terminal/context": [
        {
          "command": "herdr.terminal.find",
          "when": "herdr.terminalActive",
          "group": "0_herdr@1"
        },
        {
          "command": "herdr.terminal.openOutput",
          "when": "herdr.terminalActive",
          "group": "0_herdr@2"
        }
      ],
      "terminal/title/context": [
        {
          "command": "herdr.terminal.find",
          "when": "herdr.terminalActive",
          "group": "0_herdr@1"
        },
        {
          "command": "herdr.terminal.openOutput",
          "when": "herdr.terminalActive",
          "group": "0_herdr@2"
        }
      ],
      "editor/context": [
        {
          "command": "herdr.sendToAgent",
          "when": "herdr.connected && resourceScheme == file",
          "group": "herdr@1"
        }
      ],
      "explorer/context": [
        {
          "command": "herdr.sendToAgent",
          "when": "herdr.connected && !explorerResourceIsFolder",
          "group": "herdr@1"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "herdr.binaryPath": {
          "type": "string",
          "default": "",
          "description": "%setting.binaryPath.description%",
          "scope": "machine"
        },
        "herdr.socketPath": {
          "type": "string",
          "default": "",
          "description": "%setting.socketPath.description%",
          "scope": "machine"
        },
        "herdr.startServer": {
          "scope": "machine",
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "enumDescriptions": [
            "%setting.startServer.enumDescriptions.ask%",
            "%setting.startServer.enumDescriptions.always%",
            "%setting.startServer.enumDescriptions.never%"
          ],
          "description": "%setting.startServer.description%"
        },
        "herdr.offerHubOnStartup": {
          "type": "string",
          "enum": [
            "emptyWindows",
            "allWindows",
            "never"
          ],
          "default": "emptyWindows",
          "enumDescriptions": [
            "%setting.offerHubOnStartup.enumDescriptions.emptyWindows%",
            "%setting.offerHubOnStartup.enumDescriptions.allWindows%",
            "%setting.offerHubOnStartup.enumDescriptions.never%"
          ],
          "description": "%setting.offerHubOnStartup.description%"
        },
        "herdr.followMode": {
          "scope": "machine",
          "type": "boolean",
          "default": false,
          "description": "%setting.followMode.description%"
        },
        "herdr.terminalLocation": {
          "type": "string",
          "enum": [
            "editor",
            "editorSplit",
            "panel"
          ],
          "default": "editor",
          "enumDescriptions": [
            "%setting.terminalLocation.enumDescriptions.editor%",
            "%setting.terminalLocation.enumDescriptions.editorSplit%",
            "%setting.terminalLocation.enumDescriptions.panel%"
          ],
          "description": "%setting.terminalLocation.description%"
        },
        "herdr.revealInExplorer": {
          "type": "boolean",
          "default": false,
          "description": "%setting.revealInExplorer.description%"
        },
        "herdr.windowMode": {
          "type": "string",
          "enum": [
            "folder",
            "workspace"
          ],
          "enumDescriptions": [
            "%setting.windowMode.enumDescriptions.folder%",
            "%setting.windowMode.enumDescriptions.workspace%"
          ],
          "default": "folder",
          "markdownDescription": "%setting.windowMode.markdownDescription%"
        },
        "herdr.closeTerminalsOnSwitch": {
          "type": "boolean",
          "default": true,
          "description": "%setting.closeTerminalsOnSwitch.description%"
        },
        "herdr.restoreTabs": {
          "type": "boolean",
          "default": true,
          "description": "%setting.restoreTabs.description%"
        },
        "herdr.closeTabInHerdr": {
          "scope": "machine",
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "never",
          "enumDescriptions": [
            "%setting.closeTabInHerdr.enumDescriptions.ask%",
            "%setting.closeTabInHerdr.enumDescriptions.always%",
            "%setting.closeTabInHerdr.enumDescriptions.never%"
          ],
          "description": "%setting.closeTabInHerdr.description%"
        },
        "herdr.newWorktreeStartsWith": {
          "type": "string",
          "enum": [
            "shell",
            "ask",
            "claude",
            "codex",
            "kiro",
            "cursor"
          ],
          "enumDescriptions": [
            "%setting.newWorktreeStartsWith.enumDescriptions.shell%",
            "%setting.newWorktreeStartsWith.enumDescriptions.ask%",
            "%setting.newWorktreeStartsWith.enumDescriptions.claude%",
            "%setting.newWorktreeStartsWith.enumDescriptions.codex%",
            "%setting.newWorktreeStartsWith.enumDescriptions.kiro%",
            "%setting.newWorktreeStartsWith.enumDescriptions.cursor%"
          ],
          "default": "shell",
          "description": "%setting.newWorktreeStartsWith.description%"
        },
        "herdr.autoAttach": {
          "type": "string",
          "enum": [
            "all",
            "agents",
            "none"
          ],
          "enumDescriptions": [
            "%setting.autoAttach.enumDescriptions.all%",
            "%setting.autoAttach.enumDescriptions.agents%",
            "%setting.autoAttach.enumDescriptions.none%"
          ],
          "default": "all",
          "description": "%setting.autoAttach.description%"
        },
        "herdr.autoAttachOnSwitch": {
          "type": "boolean",
          "default": true,
          "description": "%setting.autoAttachOnSwitch.description%",
          "deprecationMessage": "%setting.autoAttachOnSwitch.deprecationMessage%"
        },
        "herdr.autoAttachShells": {
          "type": "boolean",
          "default": true,
          "description": "%setting.autoAttachShells.description%",
          "deprecationMessage": "%setting.autoAttachShells.deprecationMessage%"
        },
        "herdr.agentNames": {
          "type": "string",
          "enum": [
            "title",
            "herdr"
          ],
          "enumDescriptions": [
            "%setting.agentNames.enumDescriptions.title%",
            "%setting.agentNames.enumDescriptions.herdr%"
          ],
          "default": "title",
          "description": "%setting.agentNames.description%"
        },
        "herdr.notifyOn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "blocked",
              "done",
              "working",
              "idle"
            ]
          },
          "default": [
            "blocked",
            "done"
          ],
          "description": "%setting.notifyOn.description%"
        },
        "herdr.copyOnSelect": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%setting.copyOnSelect.markdownDescription%"
        },
        "herdr.notifyOnTakeover": {
          "type": "boolean",
          "default": false,
          "description": "%setting.notifyOnTakeover.description%"
        },
        "herdr.agents": {
          "type": "object",
          "scope": "machine",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "order": 0,
          "markdownDescription": "%setting.agents.markdownDescription%"
        },
        "herdr.kiroMonthlyCredits": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%setting.kiroMonthlyCredits.description%"
        },
        "herdr.showShellPanes": {
          "type": "boolean",
          "default": true,
          "description": "%setting.showShellPanes.description%"
        },
        "herdr.showNeedsYou": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%setting.showNeedsYou.markdownDescription%"
        },
        "herdr.spaceOrder": {
          "type": "string",
          "enum": [
            "activity",
            "herdr"
          ],
          "enumDescriptions": [
            "%setting.spaceOrder.enumDescriptions.activity%",
            "%setting.spaceOrder.enumDescriptions.herdr%"
          ],
          "default": "herdr",
          "description": "%setting.spaceOrder.description%"
        },
        "herdr.agentProfiles": {
          "type": [
            "object",
            "array"
          ],
          "scope": "machine",
          "deprecationMessage": "%setting.agentProfiles.deprecationMessage%",
          "markdownDeprecationMessage": "%setting.agentProfiles.markdownDeprecationMessage%"
        }
      }
    },
    "terminal": {
      "profiles": [
        {
          "id": "herdr.shell",
          "title": "%terminalProfile.herdr.shell%",
          "icon": "terminal"
        },
        {
